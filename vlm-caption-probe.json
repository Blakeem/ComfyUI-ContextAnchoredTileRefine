      "title": "How to use",
      "properties": {
        "text": ""
      },
      "widgets_values": [
        "Use this to test global and tile level prompts.\n\nThe global prompt will show across all tiles and should never contain specific tile details. It should contain overall details that apply to every tile.\n\n\nThe tile prompt should do well at describing that is in the image and where it is.\n\nYou can run these prompts to see how close the image it genertes is to your laoded image.\n\n\nCopy settings.toml to settings.user.toml in the `ComfyUI\\custom_nodes\\ComfyUI-ContextAnchoredTileRefine` folder and enter your own custom prompts there. There will be laoded into the VL nodes on restart."
      ],
      "widgets_values_named": {
        "text": "Use this to test global and tile level prompts.\n\nThe global prompt will show across all tiles and should never contain specific tile details. It should contain overall details that apply to every tile.\n\n\nThe tile prompt should do well at describing that is in the image and where it is.\n\nYou can run these prompts to see how close the image it genertes is to your laoded image.\n\n\nCopy settings.toml to settings.user.toml in the `ComfyUI\\custom_nodes\\ComfyUI-ContextAnchoredTileRefine` folder and enter your own custom prompts there. There will be laoded into the VL nodes on restart."
      },
      "color": "#432",
      "bgcolor": "#653"
    }
